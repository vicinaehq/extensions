{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node 16",
	"include": ["src/**/*"],
	"compilerOptions": {
		"lib": ["ES2022","DOM"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"strict": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"types": ["node"]
	}
}
