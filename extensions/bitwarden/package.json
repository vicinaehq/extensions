{
	"$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
	"name": "bitwarden",
	"title": "Bitwarden (rbw)",
	"description": "Search, copy and paste credentials from your Bitwarden vault using the rbw CLI",
	"categories": [
		"Security"
	],
	"license": "MIT",
	"platforms": [
		"Linux",
		"macOS"
	],
	"author": "bl4zee1g",
	"contributors": [],
	"pastContributors": [],
	"icon": "extension_icon.png",
	"commands": [
		{
			"name": "browse-vault",
			"title": "Browse Bitwarden Vault",
			"subtitle": "rbw",
			"description": "Search, copy and paste credentials from your Bitwarden vault using the rbw CLI",
			"mode": "view"
		}
	],
	"preferences": [
		{
			"name": "rbwPath",
			"type": "textfield",
			"required": false,
			"title": "rbw bin path",
			"description": "Path to the rbw bin",
			"default": "rbw"
		}
	],
	"scripts": {
		"build": "vici build",
		"dev": "vici develop",
		"lint": "vici lint",
		"format": "biome format --write src"
	},
	"dependencies": {
		"@vicinae/api": "^0.23.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.18",
		"typescript": "^5.9.2"
	}
}
