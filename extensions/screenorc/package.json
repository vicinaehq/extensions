{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "screenorc",
  "title": "screenORC",
  "description": "Scans a screen region for text and QR codes, copying them to the clipboard",
  "categories": [
    "Developer Tools",
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "author": "ransause",
  "contributors": [],
  "pastContributors": [],
  "icon": "assets/extension_icon.png",
  "commands": [
    {
      "name": "capture",
      "title": "Scan & copy text",
      "description": "Captures a screen region and performs OCR to extract the text",
      "mode": "no-view"
    },
    {
      "name": "qr",
      "title": "Scan QR code",
      "description": "Captures a screen region and decodes a QR code",
      "mode": "no-view"
    },
    {
      "name": "select-language",
      "title": "Select Recognition Languages",
      "description": "Choose preferred Tesseract OCR languages",
      "mode": "view"
    }
  ],
  "preferences": [],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "format": "biome format --write src",
    "lint": "vici lint",
    "typecheck": "tsc --noEmit",
    "check-dependencies": "node scripts/check-dependencies.js"
  },
  "dependencies": {
    "@vicinae/api": "^0.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  }
}