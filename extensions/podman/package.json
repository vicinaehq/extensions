{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "podman",
  "title": "Podman",
  "description": "Vicinae extension for managing local and remote Podman containers",
  "categories": ["Developer Tools", "Productivity"],
  "license": "MIT",
  "platforms": ["Linux", "macOS"],
  "author": "knoopx",
  "contributors": ["GianniBYoung"],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "containers",
      "title": "Containers",
      "subtitle": "Manage Podman containers",
      "description": "List and manage Podman containers",
      "mode": "view"
    },
    {
      "name": "images",
      "title": "Images",
      "subtitle": "Manage Podman images",
      "description": "List and manage Podman images",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "defaultConnection",
      "type": "textfield",
      "required": false,
      "default": "",
      "title": "Default Connection",
      "description": "Podman system connection to use on first launch (see `podman system connection list`). Leave empty to use podman's default.",
      "placeholder": "podman-machine-default"
    }
  ],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "vici lint"
  },
  "dependencies": {
    "@vicinae/api": "^0.22.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
