// Regenerates the `commands` array in package.json and one `src/<name>.ts`
// entrypoint per Paneru command from src/lib/commands.ts.
//
//   npm run generate
//
// Runs under plain Node (type stripping), so commands.ts must not have
// runtime imports.

import { readdirSync, readFileSync, unlinkSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { COMMANDS } from "../src/lib/commands.ts";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const src = join(root, "src");
const GENERATED_MARKER = "// @generated by scripts/generate.mts";

const pkgPath = join(root, "package.json");
const pkg = JSON.parse(readFileSync(pkgPath, "utf8"));

pkg.commands = [
	{
		name: "paneru",
		title: "Paneru Commands",
		subtitle: "Paneru",
		description: "Browse and run every Paneru window management command.",
		mode: "view",
		keywords: ["window", "tiling", "scroll", "manager"],
	},
	...COMMANDS.map((c) => ({
		name: c.name,
		title: c.title,
		subtitle: "Paneru",
		description: c.description,
		mode: "no-view",
		keywords: c.keywords ?? [],
		...(c.numberArg && {
			arguments: [
				{
					name: "number",
					placeholder: c.numberArg.placeholder,
					type: "text",
					required: true,
				},
			],
		}),
	})),
];

writeFileSync(pkgPath, `${JSON.stringify(pkg, null, "\t")}\n`);

// Remove stale generated entrypoints, then write fresh ones.
const wanted = new Set(COMMANDS.map((c) => `${c.name}.ts`));
for (const file of readdirSync(src)) {
	if (!file.endsWith(".ts") || wanted.has(file)) continue;
	const path = join(src, file);
	if (readFileSync(path, "utf8").startsWith(GENERATED_MARKER)) unlinkSync(path);
}
for (const c of COMMANDS) {
	writeFileSync(
		join(src, `${c.name}.ts`),
		`${GENERATED_MARKER}. Do not edit; change src/lib/commands.ts instead.
import { noViewCommand } from "./lib/run";

export default noViewCommand(${JSON.stringify(c.name)});
`,
	);
}

console.log(`Generated ${COMMANDS.length} no-view commands + 1 view command.`);
